[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://assets/fonts/fusion_pixel.ttf"

[dotnet]

project/assembly_name="星露谷Like"

